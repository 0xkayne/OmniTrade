// 状态机（Intent 级）—— 含唯一的阻断态与其人工出边
// 源码位置：src/coordinator/state_machine.py（_TRANSITIONS 是合法转移的权威来源）
// 重新生成：scripts/render_diagrams.sh base-state-machine-intent

digraph base_state_machine_intent {
  graph [
    fontname="Helvetica", fontsize="18",
    rankdir=TB, compound=true, nodesep=0.4, ranksep=0.55,
    labelloc="t",
    label="Intent 状态机 · 含 DRY_RUN 预览终态与显式中断恢复"
  ];
  node [fontname="Helvetica", fontsize="12", shape=box, style="rounded,filled",
        fillcolor="#f5f5f5", color="#555555"];
  edge [fontname="Helvetica", fontsize="10", color="#666666"];

  start [label="", shape=circle, width=0.15, style=filled, fillcolor="#555555", color="#555555"];
  pending   [label="PENDING\n已持久化，尚未处理"];
  validated [label="VALIDATED"];
  executing [label="EXECUTING"];
  rejected  [label="REJECTED\n终态", fillcolor="#e8f1ff", color="#3264a8"];
  dryrun [label="DRY_RUN\n预览终态", fillcolor="#e8f1ff", color="#3264a8"];
  allfilled [label="ALL_FILLED\n终态", fillcolor="#eaf7ed", color="#3c7a4a", penwidth=2];
  partial   [label="PARTIAL_FILLED"];
  timeout   [label="EXECUTE_TIMEOUT", fillcolor="#fff3df", color="#a66a14"];
  rolling   [label="ROLLING_BACK"];
  rolled    [label="ROLLED_BACK\n终态", fillcolor="#eaf7ed", color="#3c7a4a", penwidth=2];
  failed    [label="ROLLED_BACK_FAILED\n终态 · BLOCKING_STATE\n阻塞所有后续 Intent",
             fillcolor="#fdecea", color="#b3261e", penwidth=2];
  resolved  [label="RESOLVED_MANUAL\n终态", fillcolor="#eaf7ed", color="#3c7a4a"];

  start -> pending;
  pending   -> validated [label="plan 与校验通过"];
  pending -> dryrun [label="预览完成"];
  pending -> rolling [label="显式恢复", style=dashed];
  validated -> rolling [label="显式恢复", style=dashed];
  pending -> failed [label="恢复上下文无法验证", style=dashed, color="#b3261e"];
  validated -> failed [label="恢复上下文无法验证", style=dashed, color="#b3261e"];
  executing -> rolling [label="显式恢复", style=dashed];
  pending   -> rejected  [label="plan/validate/risk 失败\n未发出任何订单"];
  validated -> executing;
  validated -> rejected;
  executing -> allfilled [label="每条腿都在容差内成交"];
  executing -> partial   [label="部分成交"];
  executing -> timeout;

  executing -> failed [label="平仓失败 / 无法确认", color="#b3261e"];
  partial -> failed [label="平仓未完成", color="#b3261e"];
  timeout -> failed [label="平仓结果未确认", color="#b3261e"];
  partial -> allfilled [label="最终订单事实满足目标", style=dashed];
  timeout -> allfilled [label="最终订单事实满足目标", style=dashed];
  partial -> rolling [label="开仓补偿"];
  timeout -> rolling [label="开仓补偿"];
  rolling -> rolled  [label="补偿恢复原仓位基线"];
  rolling -> failed  [label="补偿失败"];

  failed -> resolved [label="onefill ack\n订单终结 + 仓位核对通过",
                      style=bold, color="#b3261e", fontcolor="#b3261e"];
}
