// 协调流程：五个阶段 + 前置阻断门禁 + 终态集合
// 源码位置：src/coordinator/{orchestrator,planner,validator,risk,executor,reconciler,state_machine}.py
// 重新生成：scripts/render_diagrams.sh base-coordination-pipeline

digraph base_coordination_pipeline {
  graph [
    fontname="Helvetica", fontsize="18",
    rankdir=TB, compound=true, nodesep=0.35, ranksep=0.55,
    labelloc="t",
    label="协调流程 · src/coordinator —— Orchestrator.submit(intent) 的五个阶段"
  ];
  node [fontname="Helvetica", fontsize="13", shape=box, style="rounded,filled"];
  edge [fontname="Helvetica", fontsize="10", color="#666666"];

  intent [label="Intent\n（用户输入，不含 venue 原生 symbol）",
          fillcolor="#f5f5f5", color="#555555"];

  subgraph cluster_gate {
    label="前置门禁 —— 阻断态检查";
    fontsize="13"; color="#a66a14"; style="dashed,filled"; fillcolor="#fff3df";
    block [label="count_intents_with_status(BLOCKING_STATE) > 0 ?",
           shape=diamond, style=filled, fillcolor="#fff3df", color="#a66a14"];
    rejected0 [label="REJECTED\n人工介入前不再接受新 Intent",
               fillcolor="#e8f1ff", color="#3264a8"];
  }

  subgraph cluster_pure {
    label="无副作用阶段 —— Planner / Validator 可纯单测";
    fontsize="13"; color="#3c7a4a"; style="dashed,filled"; fillcolor="#eaf7ed";
    planner [label="Planner.plan()\nplanner.py\n解析 Instrument · 取 Quote",
             fillcolor="#ffffff", color="#3c7a4a"];
    validator [label="Validator.validate()\nvalidator.py\nvenue 侧预检",
               fillcolor="#ffffff", color="#3c7a4a"];
    risk [label="RiskValidator.check()\nrisk.py\n名义上限 · 当日亏损 · 单所敞口",
          fillcolor="#ffffff", color="#3c7a4a"];
  }

  subgraph cluster_effect {
    label="有副作用阶段 —— 需 MockExchange + 内存 SQLite";
    fontsize="13"; color="#71449a"; style="dashed,filled"; fillcolor="#f3eafd";
    executor [label="Executor.execute()\nexecutor.py\n固定保护价 / 临发单预检 / 顺序拆单",
              fillcolor="#ffffff", color="#71449a"];
    reconciler [label="Reconciler.reconcile()\nreconciler.py\n逐腿先确认撤单，再保护补偿",
                fillcolor="#ffffff", color="#71449a"];
  }

  store [label="PersistenceStore\npersistence/store.py\nSQLite + JSONL",
         shape=cylinder, style=filled, fillcolor="#fff3df", color="#a66a14"];
  venue [label="venue\nexchange/ · CCXTExchange",
         shape=cylinder, style=filled, fillcolor="#f5f5f5", color="#555555"];

  rej_plan  [label="REJECTED", fillcolor="#e8f1ff", color="#3264a8"];
  rej_valid [label="REJECTED", fillcolor="#e8f1ff", color="#3264a8"];
  rej_risk  [label="REJECTED", fillcolor="#e8f1ff", color="#3264a8"];

  done    [label="终态：全部成交\nALL_FILLED",   fillcolor="#e8f1ff", color="#3264a8"];
  rolled  [label="终态：已补偿\nROLLED_BACK",     fillcolor="#e8f1ff", color="#3264a8"];
  failed  [label="终态：补偿失败\nROLLED_BACK_FAILED\n阻塞后续 Intent",
           fillcolor="#fdecea", color="#b3261e"];

  intent -> block;
  block -> rejected0 [label="是"];
  block -> planner   [label="否"];

  planner   -> rej_plan  [label="is_acceptable == false"];
  planner   -> validator [label="Plan"];
  validator -> rej_valid [label="失败"];
  validator -> risk      [label="校验通过"];
  risk      -> rej_risk  [label="失败"];
  risk      -> executor  [label="通过 → VALIDATED"];

  executor   -> done     [label="ALL_FILLED"];
  executor   -> reconciler [label="PARTIAL_FILLED"];
  reconciler -> rolled   [label="补偿成交"];
  reconciler -> failed   [label="补偿失败"];

  // 落盘与发单：Executor 先落 leg 行、再 create_order —— 这两条的顺序不可调换
  executor -> store [label="① 先落 Leg + OrderRow", style=bold, color="#b3261e", fontcolor="#b3261e"];
  executor -> venue [label="② create_order", style=bold, color="#b3261e", fontcolor="#b3261e"];
  reconciler -> venue [label="反向单", style=bold, color="#71449a", fontcolor="#71449a"];
  reconciler -> store [label="更新状态", style=dashed];
  planner -> store [label="读 Instrument / Quote", style=dashed, constraint=false];
  rej_plan  -> store [style=dotted, constraint=false];
  rej_valid -> store [style=dotted, constraint=false];
  rej_risk  -> store [style=dotted, constraint=false];
}
